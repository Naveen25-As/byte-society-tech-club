# Copy this file to .env and fill in your values:
#   copy .env.example .env

# Server port (optional — defaults to 5000)
PORT=5000

# MongoDB connection string
#
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/byte-society
#
# MongoDB Atlas (cloud — recommended for learning):
# MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/byte-society?retryWrites=true&w=majority
MONGODB_URI=
